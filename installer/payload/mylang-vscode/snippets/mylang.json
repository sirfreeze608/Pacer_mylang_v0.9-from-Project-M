{
  "Variable": {
    "prefix": "let",
    "body": ["let ${1:name} = ${2:value};"],
    "description": "Declare a variable"
  },
  "Named Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:params}) {", "\t$0", "}"],
    "description": "Declare a named function"
  },
  "Anonymous Function": {
    "prefix": "afn",
    "body": ["fn(${1:params}) {", "\t$0", "}"],
    "description": "Anonymous function expression"
  },
  "If": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "If statement"
  },
  "If Else": {
    "prefix": "ife",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "If / else"
  },
  "While": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "While loop"
  },
  "For In": {
    "prefix": "for",
    "body": ["for (${1:item} in ${2:iterable}) {", "\t$0", "}"],
    "description": "For-in loop"
  },
  "For Range": {
    "prefix": "forr",
    "body": ["for (${1:i} in range(${2:n})) {", "\t$0", "}"],
    "description": "For loop over range"
  },
  "Print": {
    "prefix": "pr",
    "body": ["print(${1:value});"],
    "description": "Print statement"
  },
  "Return": {
    "prefix": "ret",
    "body": ["return ${1:value};"],
    "description": "Return statement"
  },
  "Array": {
    "prefix": "arr",
    "body": ["let ${1:arr} = [${2:elements}];"],
    "description": "Array literal"
  },
  "Hash Map": {
    "prefix": "hash",
    "body": ["let ${1:map} = {", "\t\"${2:key}\": ${3:value}", "};"],
    "description": "Hash map literal"
  },
  "COBOL Record": {
    "prefix": "record",
    "body": [
      "record ${1:Employee} {",
      "\t${2:name} pic x(${3:30});",
      "\t${4:salary} pic 9(${5:7})v99;",
      "}",
      "",
      "let ${6:e} = ${1:Employee}();",
      "$0"
    ],
    "description": "COBOL-style fixed-width record with PIC fields"
  },
  "Record With Condition": {
    "prefix": "cond",
    "body": [
      "record ${1:Employee} {",
      "\t${2:status} pic x(1);",
      "\tcond ${3:active} for ${2:status} == \"${4:A}\";",
      "}",
      "",
      "let ${5:e} = ${1:Employee}();",
      "$0"
    ],
    "description": "88-level condition on a record field"
  },
  "Evaluate": {
    "prefix": "evaluate",
    "body": [
      "evaluate ${1:subject} {",
      "\twhen ${2:value} { $3 }",
      "\twhen ${4:low} thru ${5:high} { $6 }",
      "\twhen other { $0 }",
      "}"
    ],
    "description": "evaluate statement (multi-value / thru / default)"
  },
  "Perform Until": {
    "prefix": "perform",
    "body": ["perform until ${1:condition} {", "\t$0", "}"],
    "description": "perform until loop"
  },
  "Perform Varying": {
    "prefix": "performv",
    "body": [
      "perform varying ${1:i} from ${2:1} by ${3:1} until ${4:i > 10} {",
      "\t$0",
      "}"
    ],
    "description": "perform varying loop"
  },
  "Perform Times": {
    "prefix": "performt",
    "body": ["perform ${1:n} times {", "\t$0", "}"],
    "description": "perform N times"
  },
  "Compute": {
    "prefix": "compute",
    "body": ["compute ${1:total} = ${2:expr};"],
    "description": "compute assignment"
  },
  "Add To": {
    "prefix": "addto",
    "body": ["add ${1:value} to ${2:target};"],
    "description": "COBOL add ... to"
  },
  "Divide Giving": {
    "prefix": "divide",
    "body": ["divide ${1:a} by ${2:b} giving ${3:quotient} remainder ${4:remainder};"],
    "description": "COBOL divide with quotient and remainder"
  },
  "File Records Read": {
    "prefix": "readrec",
    "body": ["let ${1:rows} = file.read_records(\"${2:path}\", ${3:RecordType});"],
    "description": "Read fixed-width records from a file"
  },
  "File Records Write": {
    "prefix": "writerec",
    "body": ["file.write_records(\"${1:path}\", ${2:records});"],
    "description": "Write fixed-width records to a file"
  },
  "File Lines": {
    "prefix": "lines",
    "body": [
      "file.write_lines(\"${1:path}\", [${2:lines}]);",
      "let ${3:lines} = file.read_lines(\"${1:path}\");"
    ],
    "description": "Write and read a line-sequential text file"
  },
  "Slice": {
    "prefix": "slice",
    "body": ["${1:text}[${2:start}:${3:end}]"],
    "description": "Slice a string, array, or packed record"
  },
  "Exact Decimal": {
    "prefix": "dec",
    "body": ["let ${1:amount} = dec(\"${2:0.00}\");"],
    "description": "Exact decimal value for money arithmetic"
  },
  "Map": {
    "prefix": "map",
    "body": ["${1:arr}.map(fn(${2:x}) { return $0; })"],
    "description": "Array .map()"
  },
  "Filter": {
    "prefix": "filter",
    "body": ["${1:arr}.filter(fn(${2:x}) { return $0; })"],
    "description": "Array .filter()"
  },
  "Reduce": {
    "prefix": "reduce",
    "body": ["${1:arr}.reduce(fn(${2:acc}, ${3:x}) { return $0; }, ${4:init})"],
    "description": "Array .reduce()"
  },
  "Stats Summary": {
    "prefix": "statsum",
    "body": [
      "let ${1:data} = [${2:values}];",
      "print(\"mean:   \" + str(round(stats.mean(${1:data}), 2)));",
      "print(\"stdev:  \" + str(round(stats.stdev(${1:data}), 2)));",
      "print(\"min:    \" + str(stats.min(${1:data})));",
      "print(\"max:    \" + str(stats.max(${1:data})));"
    ],
    "description": "Print stats summary for an array"
  },
  "Ohms Law": {
    "prefix": "ohms",
    "body": [
      "let V = ee.voltage(${1:current}, ${2:resistance});",
      "let I = ee.current(${3:voltage}, ${4:resistance});",
      "let R = ee.resistance(${5:voltage}, ${6:current});",
      "let P = ee.power(V, I);"
    ],
    "description": "Ohm's law variables"
  },
  "RC Circuit": {
    "prefix": "rc",
    "body": [
      "let R = ${1:1000};",
      "let C = ${2:1e-6};",
      "let tau = ee.rc_tau(R, C);",
      "print(\"τ = \" + str(tau) + \" s\");",
      "print(\"Vc(t) = \" + str(ee.rc_charge(${3:5.0}, ${4:0.1}, R, C)) + \" V\");"
    ],
    "description": "RC circuit time constant"
  },
  "Linear Regression": {
    "prefix": "linreg",
    "body": [
      "let xs = [${1:x_values}];",
      "let ys = [${2:y_values}];",
      "let model = stats.linreg(xs, ys);",
      "print(\"slope:     \" + str(round(model[\"slope\"], 4)));",
      "print(\"intercept: \" + str(round(model[\"intercept\"], 4)));",
      "print(\"r²:        \" + str(round(model[\"r2\"], 4)));"
    ],
    "description": "Linear regression"
  },
  "Complex Number": {
    "prefix": "cplx",
    "body": ["let ${1:z} = complex(${2:real}, ${3:imag});"],
    "description": "Create a complex number"
  },
  "Matrix": {
    "prefix": "mat",
    "body": ["let ${1:A} = matrix([", "\t[${2:row1}],", "\t[${3:row2}]", "]);"],
    "description": "Create a matrix"
  },
  "Hello World": {
    "prefix": "hello",
    "body": ["print(\"Hello, World!\");"],
    "description": "Hello World"
  }
}
